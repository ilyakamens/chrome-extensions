{
  "manifest_version": 3,
  "name": "System Dark Mode for Google Maps",
  "version": "1.1",
  "description": "Follows system dark/light mode on Google Maps",
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
